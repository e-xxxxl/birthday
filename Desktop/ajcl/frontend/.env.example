# ─────────────────────────────────────────────────────────────
#  AJ Courier Logistics — Frontend (Vite SPA) environment
#  Copy to `.env` for local dev, or `.env.production` for the build.
#  Only VITE_-prefixed vars are exposed to the browser. Values are
#  baked in at BUILD time — rebuild + re-upload after any change.
# ─────────────────────────────────────────────────────────────

# The deployed backend origin (Render URL). No trailing slash.
VITE_API_URL=http://localhost:4000

# Browser Google Maps key (Maps JavaScript API only). Its "Websites"
# restriction must list every origin you serve from, e.g.
#   http://localhost:5173/*
#   https://your-domain.com/*
VITE_GOOGLE_MAPS_API_KEY=

# Paystack public key (safe to expose) + currency.
VITE_PAYSTACK_PUBLIC_KEY=
VITE_PAYSTACK_CURRENCY=NGN
